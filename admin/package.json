{
  "name": "remine-operations",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180",
    "build": "vite build",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "playwright test",
    "deploy": "npm run check && npm run build && wrangler deploy",
    "test:smoke": "node scripts/smoke.mjs",
    "test:worker": "node --experimental-strip-types --test worker/origin.test.mjs"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.21",
    "solid-js": "2.0.0-rc.21"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
