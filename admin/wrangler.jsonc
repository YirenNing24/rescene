{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "remine-admin",
  "main": "worker/index.ts",
  "account_id": "8355506b306aa26ed64113cdc82cf338",
  "compatibility_date": "2026-05-22",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "admin.remineph.online",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "API_ORIGIN": "https://api.remineph.online"
  }
}
