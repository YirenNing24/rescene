# Copy to .env, then: set -a; source .env; set +a
APP_ENV=development
ADDR=127.0.0.1:8080
FALKORDB_URL=redis://127.0.0.1:6379
FALKORDB_GRAPH=rescene
# Persist and back up this folder alongside FalkorDB. Contains normalized photos.
PROFILE_MEDIA_DIR=data/profile_media
# Access JWT only; persistent refresh sessions renew for 30 days.
JWT_TTL=1h
# Development generates data/jwt.key automatically if unset.
# Production requires a stable secret generated with: openssl rand -hex 32
# JWT_SECRET=

# Server-managed player wallets. Keep this key on the backend only.
# With no key, local tests run without contacting Engine.
ENGINE_BASE_URL=https://engine.fluentxverse.com
# ENGINE_API_KEY=
# ENGINE_PROJECT_ID=

# Read-only thirdweb MarketplaceV3 connection. Preview items are not listings.
MARKETPLACE_ENABLED=false
# Optional dedicated contracts:read key; falls back to ENGINE_API_KEY.
# MARKETPLACE_ENGINE_API_KEY=
MARKETPLACE_CHAIN_ID=99901
MARKETPLACE_ADDRESS=0xb5cc39d72012345198bf17c56c1bbb4adad60933
MARKETPLACE_COLLECTION_ADDRESS=0x792508772bc395d038c87e7b7b0d05c55deb0706

# Automatic verified personal-best publication (separate server-only key).
LEADERBOARD_ENABLED=false
# LEADERBOARD_ENGINE_API_KEY=
LEADERBOARD_CHAIN_ID=99901
LEADERBOARD_ADDRESS=0xc0bb3f4190d5732878536fc15c75c712e9966d33
LEADERBOARD_PUBLISHER=0x78646fedde207c4574116ac9c455b56e4091c517
LEADERBOARD_RPC_URL=https://elysium-mainnet.g.alchemy.com/v2/YOUR_SERVER_ONLY_API_KEY
LEADERBOARD_CONFIRMATIONS=3
LEADERBOARD_START_BLOCK=4774246

# STARL reward payouts: transfer existing treasury tokens via the idempotent router.
STARLIGHT_ENABLED=false
STARLIGHT_TOKEN_ADDRESS=0x910fc4146af825cb949fad284af62d3896c7cbbc
STARLIGHT_DISTRIBUTOR_ADDRESS=0x0464d7f767babcef6a800ea797ea085d69551081
STARLIGHT_TREASURY_ADDRESS=0x78646fedde207c4574116ac9c455b56e4091c517
STARLIGHT_CHAIN_ID=99901
STARLIGHT_RPC_URL=https://elysium-mainnet.g.alchemy.com/v2/YOUR_SERVER_ONLY_API_KEY
STARLIGHT_CONFIRMATIONS=3
# Optional dedicated key; falls back to ENGINE_API_KEY.
# Requires contracts:write and transactions:read for this Engine project.
# Wallet provisioning still uses ENGINE_API_KEY with wallets:write/read.
# STARLIGHT_ENGINE_API_KEY=

# The real Energy Drink (ERC-1155 ID 0, 100 STARL, +5 energy).
# Requires the Engine worker release with project-scoped managed-wallet signing.
SHOP_ENABLED=false
SHOP_ROUTER_ADDRESS=0xba0778c9419f086a2ff8c42f2c353ced3a4e6d22
SHOP_TOKEN_ID=0
SHOP_LISTING_ID=0

# First Scene member cards (450 STARL each), same collection, IDs/listings 1–5.
CARDS_ENABLED=false
CARDS_ROUTER_ADDRESS=0x4630a55c643ed987a398ee11776ba50cb1712b0a

# Individual PULSE ERC-1155 cards on Elysium; initial sales allocation is 50/member.
# Requires MINTER_ROLE and METADATA_ROLE on the collection and treasury approval.
PULSE_CARDS_ADDRESS=0x4630a55c643ed987a398ee11776ba50cb1712b0a
# Current Elysium mainnet addresses. Integration flags remain opt-in.
EVENT_REWARD_ROUTER_ADDRESS=0x2d39ea98dfc8de5820b24490aa03d9cabea38b26
LEGACY_CARDS_ROUTER_ADDRESS=
