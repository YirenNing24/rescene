static func for_song(song_id: String) -> String:
	for entry: Dictionary in SETS:
		if StrictData.array(entry.song_ids).has(song_id): return str(entry.id)
	return ""

static func find_set(set_id: String) -> Dictionary:
	for entry: Dictionary in SETS:
		if str(entry.id) == set_id: return entry
	return {}
