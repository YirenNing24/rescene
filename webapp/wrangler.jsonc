{
  "name": "rescene-rhythm-web",
  "main": "worker/index.ts",
  "account_id": "8355506b306aa26ed64113cdc82cf338",
  "compatibility_date": "2026-05-22",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "SessionVault" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionVault"] }],
  "routes": [{ "pattern": "rhythm.remineph.online", "custom_domain": true }],
  "vars": { "API_ORIGIN": "https://api.remineph.online" },
  "services": [{ "binding": "GAME_API", "service": "remine-game-api" }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
