{
  "name": "remineph-fansite",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/prerender.mjs",
    "check": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "deploy:cloudflare": "npm run check && npm run build && wrangler deploy --config wrangler.cloudflare.json",
    "test": "playwright test"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.21",
    "solid-js": "2.0.0-rc.21"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
