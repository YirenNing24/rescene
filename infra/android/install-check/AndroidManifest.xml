<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.rescene.installcheck" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <application android:label="RESCÉNE Install Check" android:icon="@drawable/icon" android:allowBackup="false" android:theme="@android:style/Theme.Material.Light.NoActionBar">
    <activity android:name=".InstallCheckActivity" android:exported="true" android:screenOrientation="portrait">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
    <receiver android:name=".InstallCheckActivity$ResultReceiver" android:exported="false" />
  </application>
</manifest>
