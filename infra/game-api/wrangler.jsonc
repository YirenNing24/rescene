{
  "name": "remine-game-api",
  "main": "worker.js",
  "account_id": "8355506b306aa26ed64113cdc82cf338",
  "compatibility_date": "2026-11-10",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api.remineph.online",
      "custom_domain": true
    }
  ],
  "vars": {
    "API_ORIGIN": "https://engine-api.fluentxverse.com",
    "APK_OBJECT_KEY": "android/0.1.26/RESCENE-Rhythm.apk"
  },
  "r2_buckets": [
    {
      "binding": "APK_RELEASES",
      "bucket_name": "rescene"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
